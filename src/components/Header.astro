---
// 選單項目：改這裡即可增減分頁
const links = [
  { href: '/about/', label: '關於我們' },
  { href: '/scripts/', label: '劇本總覽' },
  { href: '/hosts/', label: '主持人介紹' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="Re:LAX Story Lab 首頁">
      <img src="/brand/logo-mark-sm.png" alt="" width="44" height="38" />
      <span class="wordmark"><b>Re:</b><em>LAX</em><small>Story Lab</small></span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="開啟選單" />
    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span></label>
    <nav>
      {links.map((l) => <a href={l.href} class={path.startsWith(l.href) ? 'active' : ''}>{l.label}</a>)}
      <a href="/booking/" class="btn solid nav-cta">預約場次</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: rgba(251, 249, 244, 0.9); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .logo { display: flex; align-items: center; gap: 10px; color: var(--navy); }
  .logo:hover { text-decoration: none; }
  .logo img { width: 44px; height: auto; }
  .wordmark { font-family: var(--serif); font-size: 1.45rem; line-height: 1; display: flex; align-items: baseline; gap: 2px; }
  .wordmark b { font-weight: 600; }
  .wordmark em { font-style: normal; font-weight: 600; color: var(--accent); }
  .wordmark small { font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--text-dim); margin-left: 8px; }
  nav { display: flex; align-items: center; gap: 28px; }
  nav a:not(.btn) { color: var(--text-dim); letter-spacing: 0.05em; }
  nav a:not(.btn):hover, nav a.active { color: var(--navy); text-decoration: none; }
  nav a.active { box-shadow: 0 2px 0 var(--accent); }
  .nav-cta { padding: 8px 22px; }
  .nav-toggle, .burger { display: none; }

  @media (max-width: 760px) {
    .burger { display: block; width: 26px; height: 18px; position: relative; cursor: pointer; }
    .burger span, .burger::before, .burger::after {
      content: ''; position: absolute; left: 0; right: 0; height: 2px; background: var(--navy); transition: transform .2s, opacity .2s;
    }
    .burger::before { top: 0; } .burger span { top: 8px; } .burger::after { bottom: 0; }
    .nav-toggle:checked + .burger::before { transform: translateY(8px) rotate(45deg); }
    .nav-toggle:checked + .burger span { opacity: 0; }
    .nav-toggle:checked + .burger::after { transform: translateY(-8px) rotate(-45deg); }
    nav {
      display: none; position: absolute; top: 68px; left: 0; right: 0;
      flex-direction: column; gap: 0; padding: 4px 16px 20px;
      background: var(--bg); border-bottom: 1px solid var(--line);
      box-shadow: 0 12px 24px -16px rgba(27, 36, 49, .3);
    }
    nav a:not(.btn) { padding: 14px 0; width: 100%; border-bottom: 1px solid var(--line); }
    nav a.active { box-shadow: none; color: var(--accent-text); }
    .nav-cta { margin-top: 18px; width: 100%; text-align: center; padding: 12px; }
    .nav-toggle:checked ~ nav { display: flex; }
  }
  @media (max-width: 380px) { .wordmark small { display: none; } }
</style>
