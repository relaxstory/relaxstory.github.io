---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container inner">
    <img src="/brand/logo-mark-light.png" alt="" width="56" height="48" />
    <div class="name">Re:<em>LAX</em> <small>Story Lab</small></div>
    <p class="slogan">{site.slogan}</p>
    <nav>
      <a href="/about/">關於我們</a><a href="/scripts/">劇本總覽</a><a href="/hosts/">主持人介紹</a><a href="/booking/">預約場次</a><a href="/#contact">聯絡我們</a>
    </nav>
    <p class="copy">© {year} Re:LAX Story Lab. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: #d9dde3; padding: 48px 0 28px; margin-top: 0; }
  .inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  img { width: 56px; height: auto; }
  .name { font-family: var(--serif); font-size: 1.5rem; font-weight: 600; color: #fff; margin-top: 6px; }
  .name em { font-style: normal; color: var(--accent); }
  .name small { font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: #aab1bc; }
  .slogan { color: #aab1bc; letter-spacing: 0.15em; font-size: 0.9rem; margin: 4px 0 24px; }
  nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; font-size: 0.9rem; }
  nav a { color: #d9dde3; }
  .copy { margin: 28px 0 0; font-size: 0.78rem; color: #7f8794; }
</style>
