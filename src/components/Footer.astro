---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <div class="logo">Re: LAX <span>Story LAb</span></div>
      <p class="dim">劇本殺工作室・在故事裡，放鬆做另一個人。</p>
    </div>
    <div>
      <h4>聯絡資訊</h4>
      <!-- 請替換成實際資訊 -->
      <p class="dim">地址：（待填寫）<br />營業時間：（待填寫）<br />Email：（待填寫）</p>
    </div>
    <div>
      <h4>追蹤我們</h4>
      <p class="dim"><a href="#">Instagram</a>・<a href="#">Facebook</a>・<a href="#">LINE 官方帳號</a></p>
    </div>
  </div>
  <div class="container copy dim">© {year} Re: LAX Story LAb. All rights reserved.</div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--bg-elev); padding: 48px 0 24px; margin-top: 40px; }
  .cols { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .logo { font-family: var(--serif); font-size: 1.2rem; font-weight: 700; }
  .logo span { color: var(--accent); }
  h4 { margin: 0 0 8px; font-family: var(--serif); }
  .dim { color: var(--text-dim); font-size: 0.92rem; }
  .copy { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 0.82rem; }
</style>
