---
import { site } from '../data/site';
---
<dl class="contact">
  {site.contacts.map((c) => (
    <div>
      <dt>{c.label}</dt>
      <dd>{c.url
        ? <a href={c.url} target={c.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{c.text}</a>
        : c.text}</dd>
    </div>
  ))}
</dl>

<style>
  .contact { margin: 0; display: grid; gap: 12px; }
  .contact div { display: grid; grid-template-columns: 6.5em 1fr; gap: 12px; align-items: baseline; }
  dt { color: var(--accent-text); letter-spacing: 0.1em; }
  dd { margin: 0; word-break: break-all; }
</style>
