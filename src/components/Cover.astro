---
// 劇本封面：有圖用圖（自動壓縮、產生適合大小）；沒圖顯示 Logo 樣式的預設封面。
import { Picture, getImage } from 'astro:assets';
import { coverFor } from '../lib/covers';

interface Props {
  id: string;
  title: string;
  /** thumb = 卡片縮圖（裁成 3:4）；large = 詳細頁大圖（完整比例，可點開原圖） */
  size: 'thumb' | 'large';
  eager?: boolean;
}
const { id, title, size, eager = false } = Astro.props;
const img = coverFor(id);
const full = img && size === 'large' ? await getImage({ src: img, width: Math.min(img.width, 1600), format: 'webp' }) : null;
---
{img ? (
  size === 'thumb' ? (
    <Picture src={img} alt={`${title} 封面`} formats={['avif', 'webp']} widths={[240, 360, 480, 720]}
      sizes="(max-width: 560px) 120px, 360px" class="cover thumb" loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <a href={full!.src} class="cover-link" target="_blank" rel="noopener" title="查看原圖">
      <Picture src={img} alt={`${title} 封面`} formats={['avif', 'webp']} widths={[480, 720, 960, 1200]}
        sizes="(max-width: 760px) 92vw, 420px" class="cover large" loading="eager" />
    </a>
  )
) : (
  <div class={`cover placeholder ${size}`} role="img" aria-label={`${title}（尚無封面）`}>
    <img src="/brand/logo-mark-light.png" alt="" class="ph-mark" />
    <span class="ph-title">{title}</span>
  </div>
)}

<style>
  .cover { display: block; width: 100%; border-radius: 10px; }
  .cover.thumb { aspect-ratio: 3 / 4; object-fit: cover; height: auto; }
  .cover.large { height: auto; box-shadow: 0 18px 40px -22px rgba(27, 36, 49, 0.55); }
  .cover-link { display: block; }
  .placeholder {
    aspect-ratio: 3 / 4; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12%;
    background:
      radial-gradient(ellipse at 50% 25%, rgba(176, 142, 97, 0.35), transparent 60%),
      linear-gradient(160deg, #1b2431 40%, #2c3a4f);
    color: #f4efe5; text-align: center; padding: 10%;
    border: 1px solid rgba(176, 142, 97, 0.5);
  }
  .ph-mark { width: 46%; height: auto; opacity: 0.9; }
  .ph-title { font-family: var(--serif); font-weight: 600; letter-spacing: 0.08em; line-height: 1.4; font-variant-numeric: lining-nums; }
  .placeholder.thumb .ph-title { font-size: clamp(0.85rem, 2.6vw, 1.15rem); }
  .placeholder.large .ph-title { font-size: clamp(1.3rem, 5vw, 1.8rem); }
</style>
