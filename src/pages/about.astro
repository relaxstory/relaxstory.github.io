---
/*
 * 「關於我們」頁面的排版。
 * ⚠️ 文字內容請改 src/content/about.md，不用改這個檔案。
 */
import Base from '../layouts/Base.astro';
import raw from '../content/about.md?raw';
import { parseAbout } from '../lib/parseAbout';

const about = parseAbout(raw);
// 目錄上方的英文小標，依段落數自動顯示（例如 6 段 → Six Principles）
const words = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const tocLabel = `${words[about.principles.length] ?? ''} Principles`.trim();
// 依中文標點切成詞組，讓手機換行落在逗號後，不會把詞切開
const phrases = (t: string) => t.split(/(?<=[，、；：])/);
const closingTitle = about.closing?.title.split(/[｜|]/).map((s) => s.trim()) ?? [];
---
<Base title="關於我們" description={`${about.lead} 認識 Re:LAX Story Lab（雷凱斯故事實驗室）。`}>
  <!-- 開場 -->
  <header class="about-hero">
    <div class="container narrow center">
      <p class="eyebrow">About Us</p>
      <h1>{about.title}</h1>
      {about.lead && <p class="lead">{phrases(about.lead).map((t) => <span>{t}</span>)}</p>}
    </div>
  </header>

  <!-- 緣起 -->
  <section class="section">
    <div class="container narrow intro">
      {about.intro.map((b) =>
        b.type === 'pull' ? <p class="pull">{b.text}</p>
        : b.type === 'close' ? <p class="p-close">{b.text}</p>
        : b.type === 'whisper' ? <div class="whisper">{b.lines.map((l) => <p>{l}</p>)}</div>
        : b.type === 'cards' ? <ul class="costs">{b.items.map((c) => <li><strong>{c.name}</strong>{c.desc && <span>{c.desc}</span>}</li>)}</ul>
        : <p>{b.text}</p>
      )}
    </div>
  </section>

  <!-- 理念目錄 -->
  {about.principles.length > 0 && (
    <nav class="toc-wrap" aria-label="理念目錄">
      <div class="container narrow">
        <p class="eyebrow">{tocLabel}</p>
        <ol class="toc">
          {about.principles.map((p, i) => (
            <li><a href={`#p${i + 1}`}><span class="toc-no">{p.no}</span>{p.title}</a></li>
          ))}
        </ol>
      </div>
    </nav>
  )}

  <!-- 各段理念 -->
  {about.principles.map((p, i) => (
    <section class={`section principle ${i % 2 ? 'alt' : ''}`} id={`p${i + 1}`}>
      <div class="container narrow">
        <div class="p-head">
          {p.no && <span class="p-no">{p.no}</span>}
          <div>
            <h2>{p.title}</h2>
            {p.sub && <p class="p-sub">{p.sub}</p>}
          </div>
        </div>
        <div class="p-body">
          {p.blocks.map((b) =>
            b.type === 'pull' ? <p class="pull">{b.text}</p>
            : b.type === 'close' ? <p class="p-close">{b.text}</p>
            : b.type === 'whisper' ? <div class="whisper">{b.lines.map((l) => <p>{l}</p>)}</div>
            : b.type === 'cards' ? <ul class="costs">{b.items.map((c) => <li><strong>{c.name}</strong>{c.desc && <span>{c.desc}</span>}</li>)}</ul>
            : <p>{b.text}</p>
          )}
        </div>
      </div>
    </section>
  ))}

  <!-- 結語 -->
  {about.closing && (
    <section class="closing">
      <div class="container narrow center">
        <img src="/brand/logo-mark.webp" alt="" width="660" height="562" class="closing-mark" />
        {closingTitle.length > 0 && closingTitle[0] && (
          <h2>{closingTitle.map((t, i) => <>{i > 0 && <span class="sep">｜</span>}<span>{t}</span></>)}</h2>
        )}
        {about.closing.mottos.length > 0 && (
          <p class="mottos">{about.closing.mottos.map((m) => <span>{m}</span>)}</p>
        )}
        {about.closing.text.map((t) => <p class="final">{phrases(t).map((x) => <span>{x}</span>)}</p>)}
        <div class="actions">
          <a href="/scripts/" class="btn">劇本總覽</a>
          <a href="/booking/" class="btn solid">預約場次</a>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .narrow { max-width: 720px; }

  /* 開場 */
  .about-hero {
    padding: clamp(56px, 10vw, 104px) 0 clamp(40px, 7vw, 72px);
    background: radial-gradient(ellipse at 50% 20%, rgba(176, 142, 97, 0.14), transparent 65%);
    border-bottom: 1px solid var(--line);
  }
  .about-hero h1 { font-size: clamp(1.9rem, 6vw, 2.8rem); margin: 6px 0 18px; }
  .lead {
    font-family: var(--serif); font-size: clamp(1.15rem, 3.4vw, 1.5rem);
    color: var(--accent-text); letter-spacing: 0.06em; margin: 0;
  }

  /* 內文共用 */
  .intro p, .p-body p { font-size: 1.05rem; color: #3a4250; margin: 0 0 1.1em; }
  .intro p:first-child {
    font-family: var(--serif); font-size: 1.2rem; color: var(--text); font-weight: 600;
    text-align: center; margin-bottom: 2em;
  }
  .pull {
    font-family: var(--serif); font-size: clamp(1.2rem, 3.6vw, 1.45rem) !important; font-weight: 600;
    color: var(--navy) !important; text-align: center; line-height: 1.6;
    margin: 1.6em 0 !important; padding: 0.9em 0.5em;
    border-block: 1px solid var(--line); position: relative;
  }
  .pull::before {
    content: '✦'; position: absolute; top: -0.7em; left: 50%; transform: translateX(-50%);
    background: var(--bg); color: var(--accent); padding: 0 10px; font-size: 0.8rem;
  }

  /* 目錄 */
  .toc-wrap { padding: 48px 0; background: var(--bg-elev); border-block: 1px solid var(--line); }
  .toc { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .toc a {
    display: flex; align-items: baseline; gap: 12px; padding: 12px 16px;
    background: var(--bg-card); border: 1px solid var(--line); border-radius: 10px; color: var(--text);
    transition: border-color .2s;
  }
  .toc a:hover { border-color: var(--accent); text-decoration: none; }
  .toc-no { font-family: var(--serif); font-size: 1.3rem; color: var(--accent); font-weight: 600; min-width: 1.6em; font-variant-numeric: lining-nums; }

  /* 理念段落 */
  .principle { scroll-margin-top: 68px; }
  .principle.alt { background: var(--bg-elev); }
  .p-head { display: flex; gap: 20px; align-items: flex-start; margin-bottom: 28px; }
  .p-no {
    font-family: var(--serif); font-size: clamp(3rem, 10vw, 4.4rem); line-height: 0.9; font-weight: 500;
    color: var(--accent); flex-shrink: 0; padding-right: 20px; border-right: 1px solid var(--accent);
    font-variant-numeric: lining-nums;
  }
  .p-head h2 { font-size: clamp(1.35rem, 4.2vw, 1.9rem); margin: 0 0 6px; text-wrap: balance; }
  .p-sub, .p-close, .pull, .intro p:first-child { text-wrap: balance; }
  .p-sub { margin: 0; color: var(--accent-text); font-family: var(--serif); font-size: 1.08rem; letter-spacing: 0.04em; }

  .whisper {
    margin: 1.6em 0; padding: 1.2em 1.4em; border-left: 2px solid var(--accent);
    background: linear-gradient(90deg, rgba(176, 142, 97, 0.1), transparent);
  }
  .whisper p { font-family: var(--serif); font-style: italic; color: var(--text) !important; margin: 0 0 0.5em !important; }
  .whisper p:last-child { margin-bottom: 0 !important; }

  .costs { list-style: none; padding: 0; margin: 1.4em 0 1.8em; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .costs li { background: var(--bg-card); border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 10px; padding: 16px 18px; }
  .costs strong { display: block; font-family: var(--serif); font-size: 1.12rem; color: var(--navy); margin-bottom: 4px; }
  .costs span { color: var(--text-dim); font-size: 0.95rem; }

  .p-close {
    margin: 1.8em 0 0 !important; padding: 1.1em 1.3em; border-radius: 10px;
    background: var(--navy); color: #f4efe5 !important;
    font-family: var(--serif); font-weight: 600; font-size: 1.12rem !important; line-height: 1.7;
  }

  /* 結語 */
  .closing { padding: clamp(64px, 10vw, 104px) 0; border-top: 1px solid var(--line); }
  .closing-mark { width: 120px; height: auto; margin: 0 auto 16px; }
  .closing h2 { font-size: clamp(1.4rem, 4.6vw, 2rem); margin: 0 0 20px; word-break: keep-all; }
  .closing .sep { color: var(--accent); }
  .mottos { display: flex; flex-direction: column; gap: 4px; font-family: var(--serif); font-size: clamp(1.1rem, 3.4vw, 1.3rem); color: var(--accent-text); margin: 0 0 28px; }
  .final { color: var(--text-dim); font-size: 1.05rem; max-width: 34em; margin: 0 auto 32px; }
  .lead span, .final span { display: inline-block; }
  .actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 560px) {
    /* 手機：編號在上、標題在下，避免標題被擠到斷行 */
    .p-head { flex-direction: column; gap: 10px; }
    .p-no { font-size: 2.6rem; padding: 0 0 8px; border-right: 0; border-bottom: 1px solid var(--accent); }
    .toc { grid-template-columns: 1fr; }
    .whisper { padding: 1em 1.1em; }
    .closing h2 .sep { display: none; }
    .closing h2 span { display: block; }
  }
</style>
