---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { getCollection } from 'astro:content';
// 線上預約系統開發中（relaxstory.github.io）。上線後把下方按鈕改連到預約系統即可。
const titles = Object.fromEntries(
  (await getCollection('scripts', (s) => s.data.status === '上架中')).map((s) => [s.id, s.data.title]),
);
---
<Base title="預約場次" description="預約 Re:LAX Story Lab 劇本殺場次。">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Booking</p>
      <h1 class="section-title">預約場次</h1>
      <div class="card notice">
        <h2>線上預約系統即將推出</h2>
        <p>目前請透過 Email 或 Instagram 私訊與我們聯繫預約，告訴我們想玩的劇本、人數與時段：</p>
        <p id="picked" class="picked" data-titles={JSON.stringify(titles)} hidden></p>
        <Contact />
        <div class="actions"><a href="/scripts/" class="btn">先去看看劇本</a></div>
      </div>
    </div>
  </section>
</Base>

<script>
  // 從劇本頁點「預約這個劇本」進來時，顯示所選劇本
  const id = new URLSearchParams(location.search).get('script');
  const el = document.getElementById('picked');
  if (id && el) {
    const titles = JSON.parse(el.dataset.titles || '{}');
    const title = titles[id];
    if (title) {
      el.textContent = `你選擇的劇本：《${title}》（聯繫時請一併告知）`;
      el.hidden = false;
    }
  }
</script>

<style>
  .narrow { max-width: 760px; }
  .notice h2 { margin-top: 0; color: var(--accent-text); }
  .picked { padding: 10px 14px; background: var(--bg-elev); border-radius: 8px; border-left: 3px solid var(--accent); }
  .actions { margin-top: 28px; }
</style>
