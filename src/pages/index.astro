---
import Base from '../layouts/Base.astro';
import ScriptCard from '../components/ScriptCard.astro';
import Contact from '../components/Contact.astro';
import { getCollection } from 'astro:content';

// 首頁精選劇本：依 order 排序取前 3 部（已下架不顯示）
const scripts = (await getCollection('scripts', (s) => s.data.status !== '已下架'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---
<Base>
  <!-- 主視覺 -->
  <section class="hero">
    <div class="container">
      <img class="hero-logo" src="/brand/logo-full.webp" width="669" height="867"
           alt="Re:LAX Story Lab — 每次相遇，都是一段值得記得的故事" />
      <div class="actions">
        <a href="/booking/" class="btn solid">預約場次</a>
        <a href="/scripts/" class="btn">劇本總覽</a>
      </div>
    </div>
  </section>

  <!-- 工作室理念 -->
  <section class="section">
    <div class="container center philosophy">
      <p class="eyebrow">Our Philosophy</p>
      <h2 class="section-title">工作室理念</h2>
      <p>我們相信，每一段故事都值得被用心呈現，<br class="br-wide" />每一次相遇都值得被珍藏。</p>
      <p>在 Re:LAX Story Lab，我們以專業承載故事，以細節創造沉浸，<br class="br-wide" />讓每一位走進故事的人，都能帶走一段不只存在於劇本裡的回憶。</p>
      <a href="/about/" class="more">了解更多關於我們 →</a>
    </div>
  </section>

  <!-- 精選劇本 -->
  <section class="section alt">
    <div class="container">
      <div class="head">
        <div>
          <p class="eyebrow">Featured Scripts</p>
          <h2 class="section-title">精選劇本</h2>
        </div>
        <a href="/scripts/" class="more">更多劇本 →</a>
      </div>
      <div class="grid">{scripts.map((s) => <ScriptCard script={s} />)}</div>
    </div>
  </section>

  <!-- 預約 -->
  <section class="section center">
    <div class="container">
      <p class="eyebrow">Booking</p>
      <h2 class="section-title">準備好走進故事了嗎？</h2>
      <p class="section-sub">選好劇本，約上朋友，剩下的交給我們。</p>
      <a href="/booking/" class="btn solid">立即預約</a>
    </div>
  </section>

  <!-- 聯絡方式 -->
  <section class="section alt" id="contact">
    <div class="container contact-wrap">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="section-title">聯絡我們</h2>
        <p class="section-sub">包場、團建或任何問題，都歡迎與我們聯繫。</p>
      </div>
      <div class="card"><Contact /></div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(40px, 8vw, 80px) 0 clamp(56px, 9vw, 96px);
    text-align: center;
    background: radial-gradient(ellipse at 50% 30%, rgba(176, 142, 97, 0.12), transparent 65%);
    border-bottom: 1px solid var(--line);
  }
  .hero-logo { width: min(420px, 82vw); height: auto; margin: 0 auto; }
  .actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
  .philosophy { max-width: 720px; }
  .philosophy p:not(.eyebrow) { color: var(--text-dim); font-size: 1.05rem; }
  .more { display: inline-block; margin-top: 12px; letter-spacing: 0.05em; }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .head .section-title { margin: 0; }
  .contact-wrap { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); align-items: start; }
  @media (max-width: 640px) { .br-wide { display: none; } }
</style>
